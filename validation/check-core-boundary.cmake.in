set(public_headers
  "@PROJECT_SOURCE_DIR@/include/toon/render_world.hpp"
  "@PROJECT_SOURCE_DIR@/include/toon/extraction.hpp"
  "@PROJECT_SOURCE_DIR@/include/toon/overlay.hpp"
  "@PROJECT_SOURCE_DIR@/include/toon/backend.hpp"
  "@PROJECT_SOURCE_DIR@/include/toon/vulkan_backend.hpp"
  "@PROJECT_SOURCE_DIR@/include/toon/vulkan_present.hpp")
set(forbidden_tokens "vulkan/" "pxr/" "Qt" "windows.h" "d3d" "Metal/" "webgpu/" "webgpu.h" "dawn/"
  "avatarRuntime/")

foreach(header IN LISTS public_headers)
  file(READ "${header}" source)
  foreach(token IN LISTS forbidden_tokens)
    string(FIND "${source}" "${token}" found)
    if(NOT found EQUAL -1)
      message(FATAL_ERROR "core boundary violation: ${header} contains '${token}'")
    endif()
  endforeach()
endforeach()
