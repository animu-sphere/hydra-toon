@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@TOON_WITH_VULKAN@)
  find_dependency(Vulkan 1.3)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ToonTargets.cmake")
foreach(component IN LISTS Toon_FIND_COMPONENTS)
  if(component STREQUAL "AvatarState" AND
      EXISTS "${CMAKE_CURRENT_LIST_DIR}/ToonAvatarStateTargets.cmake")
    find_path(TOON_AVATAR_RUNTIME_INCLUDE_DIR avatarRuntime/api.h)
    if(TOON_AVATAR_RUNTIME_INCLUDE_DIR)
      if(NOT TARGET Toon::AvatarRuntimeHeaders)
        add_library(Toon::AvatarRuntimeHeaders INTERFACE IMPORTED)
        set_target_properties(Toon::AvatarRuntimeHeaders PROPERTIES
          INTERFACE_INCLUDE_DIRECTORIES "${TOON_AVATAR_RUNTIME_INCLUDE_DIR}")
      endif()
      include("${CMAKE_CURRENT_LIST_DIR}/ToonAvatarStateTargets.cmake")
      set(Toon_AvatarState_FOUND TRUE)
    endif()
  endif()
endforeach()
check_required_components(Toon)
