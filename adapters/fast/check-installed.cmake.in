function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Installed consumer failed (${result}): ${output}\n${error}")
  endif()
endfunction()
set(prefix "@CMAKE_CURRENT_BINARY_DIR@/consumer-prefix")
run("@CMAKE_COMMAND@" --install "@CMAKE_BINARY_DIR@" --config "${CONFIG}" --prefix "${prefix}")
foreach(component IN ITEMS OFF ON)
  set(build "@CMAKE_CURRENT_BINARY_DIR@/consumer-${component}")
  run("@CMAKE_COMMAND@" -S "@CMAKE_CURRENT_SOURCE_DIR@/installed-consumer" -B "${build}"
    -G "@CMAKE_GENERATOR@" "-DCMAKE_PREFIX_PATH=${prefix}" "-DAVATAR_COMPONENT=${component}"
    "-DTOON_AVATAR_RUNTIME_INCLUDE_DIR=@TOON_AVATAR_RUNTIME_INCLUDE_DIR@"
    "-DVulkan_INCLUDE_DIR=@Vulkan_INCLUDE_DIR@" "-DVulkan_LIBRARY=@Vulkan_LIBRARY@")
  run("@CMAKE_COMMAND@" --build "${build}" --config "${CONFIG}")
  if(EXISTS "${build}/${CONFIG}/consumer.exe")
    run("${build}/${CONFIG}/consumer.exe")
  elseif(EXISTS "${build}/consumer.exe")
    run("${build}/consumer.exe")
  else()
    run("${build}/consumer")
  endif()
endforeach()
