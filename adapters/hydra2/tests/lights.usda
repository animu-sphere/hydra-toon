#usda 1.0
# SPDX-License-Identifier: Apache-2.0
(
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 2
)

def DistantLight "Key"
{
    color3f inputs:color = (0.5, 0.25, 1)
    float inputs:intensity.timeSamples = { 1: 2, 2: 4 }
    float inputs:exposure = 1
    double xformOp:rotateY.timeSamples = { 1: 0, 2: 90 }
    uniform token[] xformOpOrder = ["xformOp:rotateY"]
}
def SphereLight "Point"
{
    float inputs:intensity = 3
    float inputs:diffuse = 0.5
    bool inputs:enableColorTemperature = true
    float inputs:colorTemperature = 3000
    double3 xformOp:translate = (1, 2, 3)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
def SphereLight "Spot" (
    prepend apiSchemas = ["ShapingAPI"]
)
{
    float inputs:intensity = 4
    float inputs:shaping:cone:angle = 30
    float inputs:shaping:cone:softness = 0.5
    token visibility.timeSamples = { 1: "inherited", 2: "invisible" }
}
def DomeLight "Ambient"
{
    color3f inputs:color = (0.1, 0.2, 0.3)
    float inputs:intensity = 0.5
}
def Mesh "Triangle"
{
    point3f[] points = [(-0.8, -0.8, 0), (0.8, -0.8, 0), (0, 0.8, 0)]
    int[] faceVertexCounts = [3]
    int[] faceVertexIndices = [0, 1, 2]
    uniform token subdivisionScheme = "none"
}
