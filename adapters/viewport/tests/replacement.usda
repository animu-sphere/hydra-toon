#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Z"
)

# Reuses the smoke stage's mesh path, but changes its geometry and colour.
# Equal resource ids and initial revisions must not reuse the old GPU data.
def Xform "World"
{
    def Mesh "Triangle"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(-50, 0, -25), (50, 0, -25), (25, 0, 50)]
        color3f[] primvars:displayColor = [(0.05, 0.3, 1)] (
            interpolation = "constant"
        )
    }
}
