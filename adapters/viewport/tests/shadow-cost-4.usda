#usda 1.0
# SPDX-License-Identifier: Apache-2.0
(
    doc = """shadow-cost.usda with three more distant lights: four shadow views."""
    defaultPrim = "Scene"
    subLayers = [@./shadow-cost.usda@]
)
over Xform "Scene"
{
    def DistantLight "Fill1"
    {
        float inputs:intensity = 0.3
        float3 xformOp:rotateXYZ = (-30,35,0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
    def DistantLight "Fill2"
    {
        float inputs:intensity = 0.3
        float3 xformOp:rotateXYZ = (25,-25,0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
    def DistantLight "Fill3"
    {
        float inputs:intensity = 0.3
        float3 xformOp:rotateXYZ = (30,30,0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
}
