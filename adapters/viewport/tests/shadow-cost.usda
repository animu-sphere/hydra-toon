#usda 1.0
# SPDX-License-Identifier: Apache-2.0
(
    doc = """Original bounded fixture for the shared shadow views' cost
    (shadow policy section 8): a 4 m backdrop facing the camera, under one
    distant light and a dome, and 16 rigidly skinned octahedra before it, half
    PreviewSurface and half unbound display colour, bobbing and turning on
    their joints, one also stretched by a blend shape. Every update after
    the first is pose and weight."""
    defaultPrim = "Scene"
    startTimeCode = 1
    endTimeCode = 61
    metersPerUnit = 1
    upAxis = "Y"
)
def Xform "Scene"
{
    def Scope "Looks"
    {
        def Material "Backdrop"
        {
            token outputs:surface.connect = </Scene/Looks/Backdrop/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8,0.8,0.8)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
        def Material "Figure"
        {
            token outputs:surface.connect = </Scene/Looks/Figure/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9,0.5,0.3)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }
